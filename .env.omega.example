# Exemple de configuration ON-PREMISE de GANDAL-API (cluster Omega).
# Copier en .env sur le contrôleur (emilia) et adapter. NE PAS commiter de secret réel.

# ── Service ──────────────────────────────────────────────────────────────────
ENVIRONMENT=production
# Base de données. PostgreSQL recommandé en prod ; SQLite suffit pour un déploiement léger.
DATABASE_URL=postgresql://dc:dc@localhost:5432/dc_backend
# DATABASE_URL=sqlite:////var/lib/gandal/gandal.db

# Front autorisé (CORS) — l'URL où tourne le Next.js.
CORS_ORIGINS=http://192.168.123.100:3000,http://localhost:3000

# ── Sécurité ─────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGER-CE-SECRET
SUPERADMIN_SECRET_KEY=CHANGER-CETTE-CLE
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=CHANGER-CE-MOT-DE-PASSE

# ── Backend Proxmox = Omega (pilote nos scripts) ─────────────────────────────
PROXMOX_BACKEND=omega
# Sur emilia, pvesh est local → OMEGA_EXEC_MODE=local (auto le détecte aussi).
OMEGA_EXEC_MODE=local
OMEGA_REPO_ROOT=/opt/omega-remote-paging
# En mode SSH (backend hors nœud PVE) : renseigner contrôleur + clé.
# OMEGA_EXEC_MODE=ssh
# OMEGA_CONTROLLER_HOST=192.168.123.100
# OMEGA_SSH_KEY=/root/.ssh/omega_ed25519

# Quota VMs par étudiant.
MAX_VMS_PER_STUDENT=2
