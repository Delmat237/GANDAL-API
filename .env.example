ENVIRONMENT=local
DATABASE_URL=postgresql://dc:dc@localhost:5432/dc_backend
TEST_DATABASE_URL=sqlite:///:memory:

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

SUPERADMIN_USERNAME=admin
SUPERADMIN_EMAIL=admin@dc.local
SUPERADMIN_PASSWORD=changeme123
SUPERADMIN_SECRET_KEY=change-me-admin-secret

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://gandal-app.10.50.30.102.nip.io,http://gandal.10.50.30.102.nip.io

MAX_VMS_PER_STUDENT=2
DEFAULT_PAGE_SIZE=20

PROXMOX_ENABLED=false
# Mode simulation : approuver une requête create-vm enregistre la VM en base
# (status "waiting") sans appeler Proxmox. À activer si l'hyperviseur est injoignable.
PROXMOX_SIMULATION_MODE=false
# Cluster Proxmox (conventions Omega / scripts cluster.conf).
PROXMOX_HOST=192.168.123.100
PROXMOX_USER=root@pam
PROXMOX_TOKEN_ID=gandal
PROXMOX_TOKEN_SECRET=your-secret-token
PROXMOX_VERIFY_SSL=false
PROXMOX_DEFAULT_NODE=emilia
# stockage.ceph = RBD partagé (OMEGA_VM_STORAGE). Ignoré si PROXMOX_CLONE_FULL=false.
PROXMOX_VM_STORAGE=stockage.ceph
PROXMOX_NET0_TEMPLATE=virtio,bridge=vmbr2
# Plage de VMID réservée à GANDAL (premier ID libre alloué dans l'intervalle).
PROXMOX_VMID_RANGE_START=2400
PROXMOX_VMID_RANGE_END=2499
# Clone lié (false) = OMEGA_VM_LINKED_CLONE=1 : rapide, disque sur le storage du template.
# Clone complet (true) : copie vers PROXMOX_VM_STORAGE (lent sur ceph -> local-lvm).
PROXMOX_CLONE_FULL=false
# Délai max (s) d'attente de la fin du clonage avant configuration de la VM.
PROXMOX_CLONE_TIMEOUT=300
# Délai max (s) pour récupérer l'IP via qemu-guest-agent après démarrage.
PROXMOX_IP_POLL_TIMEOUT=45

EMAIL_BACKEND=log
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@dc-backend.local
