ENVIRONMENT=local
DATABASE_URL=postgresql://dc:dc@localhost:5432/dc_backend
TEST_DATABASE_URL=sqlite:///:memory:

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

SUPERADMIN_USERNAME=admin
SUPERADMIN_EMAIL=admin@dc.local
SUPERADMIN_PASSWORD=changeme123
SUPERADMIN_SECRET_KEY=change-me-admin-secret

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

MAX_VMS_PER_STUDENT=2
DEFAULT_PAGE_SIZE=20

PROXMOX_ENABLED=false
# Mode simulation : approuver une requête create-vm enregistre la VM en base
# (status "waiting") sans appeler Proxmox. À activer si l'hyperviseur est injoignable.
PROXMOX_SIMULATION_MODE=false
PROXMOX_HOST=192.168.1.176
PROXMOX_USER=root@pam
PROXMOX_TOKEN_ID=horizon_token
PROXMOX_TOKEN_SECRET=your-secret-token
PROXMOX_VERIFY_SSL=false
PROXMOX_DEFAULT_NODE=pve
PROXMOX_VM_STORAGE=local-lvm
PROXMOX_NET0_TEMPLATE=virtio,bridge=vmbr0

EMAIL_BACKEND=log
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@dc-backend.local
